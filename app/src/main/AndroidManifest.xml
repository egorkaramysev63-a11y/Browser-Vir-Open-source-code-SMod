<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://android.com"
    package="com.vir.brower"
	android:installLocation="internalOnly">

    <!-- ========================================================== -->
    <!-- СЕТЕВЫЕ РАЗРЕШЕНИЯ (БРАУЗЕР, VPN, ОБНОВЛЕНИЯ ИИ)            -->
    <!-- ========================================================== -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- ========================================================== -->
    <!-- ФАЙЛОВАЯ СИСТЕМА (БЭКАПЫ, ZIP-СЕРИАЛИЗАЦИЯ И СКАЧИВАНИЕ)   -->
    <!-- ========================================================== -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <!-- Для Android 11+ (Полный доступ к файлам, чтобы бэкапы не блокировались) -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- ========================================================== -->
    <!-- РАЗРЕШЕНИЯ ДЛЯ МЕССЕНДЖЕРА (SMS, MMS И СОТОВАЯ СЕТЬ)       -->
    <!-- ========================================================== -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- ========================================================== -->
    <!-- БЕСПРОВОДНЫЕ ТЕХНОЛОГИИ (BLUETOOTH ЧАТ И NFC ОПЛАТА)       -->
    <!-- ========================================================== -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <!-- Для Android 12+ (Обязательно для поиска ID узлов рядом) -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Бесконтактная NFC оплата -->
    <uses-permission android:name="android.permission.NFC" />
	<uses-permission android:name="android.permission.USE_BIOMETRIC" />
	<uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <!-- ========================================================== -->
    <!-- СИСТЕМНЫЕ ФУНКЦИИ (АВТООБНОВЛЕНИЯ, QR И УВЕДОМЛЕНИЙ)       -->
    <!-- ========================================================== -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Аппаратные фичи, чтобы маркет не ругался на старые устройства -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <!-- ========================================================== -->
    <!-- ЯДРО ПРИЛОЖЕНИЯ И ВСЕ ЕГО ЭКРАНЫ                           -->
    <!-- ========================================================== -->
	<application
		android:allowBackup="true"
		android:icon="@drawable/icon"
		android:label="@string/app_name_setup"
		android:theme="@android:style/Theme.Material"
		android:resizeableActivity="true"
		android:usesCleartextTraffic="true"
		android:requestLegacyExternalStorage="true"> 

		<!-- Виджет 1: Быстрый Поиск -->
		<receiver android:name=".SearchWidgetProvider" android:exported="true" android:label="Vir Поиск">
			<intent-filter>
				<action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
			</intent-filter>
			<meta-data android:name="android.appwidget.provider" android:resource="@xml/search_widget_info" />
		</receiver>

		<!-- Виджет 2: Быстрые Закладки -->
		<receiver android:name=".BookmarksWidgetProvider" android:exported="true" android:label="Vir Закладки">
			<intent-filter>
				<action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
			</intent-filter>
			<meta-data android:name="android.appwidget.provider" android:resource="@xml/bookmarks_widget_info" />
		</receiver>


		<!-- 1. АКТИВНОСТЬ ПРОВЕРКИ ОБНОВЛЕНИЙ (СТАРТУЕТ ПЕРВОЙ) -->
		<activity
			android:name=".UpdateCheckActivity"
			android:label="@string/app_name"
			android:theme="@android:style/Theme.Material.NoActionBar"
			android:exported="true">
			<!-- ИНТЕНТ-ФИЛЬТР ОТСЮДА УБРАН, ЧТОБЫ ИЗБЕЖАТЬ ДУБЛИРОВАНИЯ ИКОНОК -->
		</activity>

		<!-- 1. Новая (По умолчанию включена) -->
		<activity-alias
			android:name=".UpdateCheckActivityIcon"
			android:enabled="true"
			android:icon="@drawable/icon"
			android:label="@string/app_name"
			android:targetActivity=".UpdateCheckActivity"
			android:exported="true">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity-alias>

		<!-- 2. Класика -->
		<activity-alias
			android:name=".UpdateCheckActivityIcon1"
			android:enabled="false"
			android:icon="@drawable/icon1"
			android:label="@string/app_name"
			android:targetActivity=".UpdateCheckActivity"
			android:exported="true">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity-alias>

		<!-- 3. Браузер в Android -->
		<activity-alias
			android:name=".UpdateCheckActivityIcon2"
			android:enabled="false"
			android:icon="@drawable/icon2"
			android:label="@string/app_name"
			android:targetActivity=".UpdateCheckActivity"
			android:exported="true">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity-alias>

		<!-- 4. Android -->
		<activity-alias
			android:name=".UpdateCheckActivityIcon3"
			android:enabled="false"
			android:icon="@drawable/icon3"
			android:label="@string/app_name"
			android:targetActivity=".UpdateCheckActivity"
			android:exported="true">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity-alias>

		<!-- 5. Android Old 2 -->
		<activity-alias
			android:name=".UpdateCheckActivityIcon4"
			android:enabled="false"
			android:icon="@drawable/icon4"
			android:label="@string/app_name"
			android:targetActivity=".UpdateCheckActivity"
			android:exported="true">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity-alias>

		<!-- 6. Android New -->
		<activity-alias
			android:name=".UpdateCheckActivityIcon5"
			android:enabled="false"
			android:icon="@drawable/icon5"
			android:label="@string/app_name"
			android:targetActivity=".UpdateCheckActivity"
			android:exported="true">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity-alias>
		
		<!-- 2. ГЛАВНЫЙ ЭКРАН БРАУЗЕРА (СИСТЕМНЫЙ ФИЛЬТР БРАУЗЕРА ПО УМОЛЧАНИЮ) -->
		<activity
			android:name=".MainActivity"
			android:label="@string/app_name_setup"
			android:configChanges="orientation|screenSize|keyboardHidden"
			android:theme="@android:style/Theme.Material.NoActionBar"
			android:exported="true">

			<!-- 🔥 ФИЛЬТР 1: Перехват веб-ссылок из мессенджеров, почты и документов -->
			<intent-filter android:priority="100">
				<action android:name="android.intent.action.VIEW" />
				<category android:name="android.intent.category.DEFAULT" />
				<category android:name="android.intent.category.BROWSABLE" />
				<data android:scheme="http" />
				<data android:scheme="https" />
			</intent-filter>

			<!-- 🔥 ФИЛЬТР 2: Объявление приложения как системного БРАУЗЕРА (Обязательно для кнопки в настройках) -->
			<intent-filter>
				<action android:name="android.intent.action.VIEW" />
				<category android:name="android.intent.category.DEFAULT" />
				<category android:name="android.intent.category.BROWSABLE" />
				<data android:scheme="http" />
				<data android:scheme="https" />
				<!-- Системные типы данных для открытия локальных сохраненных web-страниц -->
				<data android:mimeType="text/html" />
				<data android:mimeType="text/plain" />
				<data android:mimeType="application/xhtml+xml" />
			</intent-filter>

			<!-- 🔥 ФИЛЬТР 3: Привязка к глобальному веб-поиску Android (Ассистенты, Виджеты) -->
			<intent-filter>
				<action android:name="android.intent.action.WEB_SEARCH" />
				<category android:name="android.intent.category.DEFAULT" />
			</intent-filter>
		</activity>

		<!-- 3. ВХОД И РЕГИСТРАЦИЯ VIR ID (+ СКАЧИВАНИЕ СВЕРХУ) -->
		<activity 
			android:name=".LoginActivity" 
			android:label="Vir ID"
			android:configChanges="orientation|screenSize|keyboardHidden" 
			android:theme="@android:style/Theme.Material"/> 

		<!-- 4. ЧАТ-КОМБАЙН (ИИ + BT + SMS/MMS Письма) -->
		<activity 
			android:name=".ChatActivity" 
			android:label="Vir Чат Beta"
			android:configChanges="orientation|screenSize|keyboardHidden" 
			android:theme="@android:style/Theme.Material"/>

		<!-- 5. РЕДАКТОР АККАУНТА (Просмотр сессий, моделей, бэкап) -->
		<activity 
			android:name=".BuildActivity" 
			android:label="Vir ID Update" 
			android:theme="@android:style/Theme.Material"/>

		<!-- 6. HUT ЗАЩИТА (Мастер-Ключ верификации и защита сессии) -->
		<activity 
			android:name=".HutActivity" 
			android:label="Hut Защита"
			android:theme="@android:style/Theme.Material"/>

		<!-- 8. VIR PLAY NFC (Оплата МИР и Mastercard) -->
		<activity 
			android:name=".PlayActivity" 
			android:label="Vir Play"
			android:theme="@android:style/Theme.Material"/>

		<!-- 9. ДАННЫЕ DATA (Календарь Vir) -->
		<activity 
			android:name=".DataActivity" 
			android:label="Vir Календарь" 
			android:theme="@android:style/Theme.Material"/>

		<!-- 10. МИНИ-ИГРА СУДОКУ GAMEMINI -->
		<activity 
			android:name=".GameminiActivity"
			android:screenOrientation="portrait"
			android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" />
		<activity 
			android:name=".GameActivity"
			android:screenOrientation="portrait"
			android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" />

		<!-- КАРТА MAPACTIVITY на базе Google Maps -->
		<activity 
			android:name=".MapActivity" 
			android:label="Vir Карты"
			android:theme="@android:style/Theme.Material"/>

		<!-- ПАНЕЛЬ СЕРВИСОВ VIR SERVICEACTIVITY -->
		<activity 
			android:name=".ServiceActivity" 
			android:label="Vir Сервисы" 
			android:theme="@android:style/Theme.Material"/>
		<activity 
			android:name=".SModActivity"
			android:label="SMod Manager"
			android:configChanges="orientation|screenSize"
			android:theme="@android:style/Theme.Material"/>
		<activity 
			android:name=".QrScannerActivity"
			android:label="Сканер"
			android:configChanges="orientation|screenSize"
			android:theme="@android:style/Theme.Material"/>
		<activity 
			android:name=".CalcActivity"
			android:label="Калькулятор"
			android:configChanges="orientation|screenSize"
			android:theme="@android:style/Theme.Material"/>
		<activity 
			android:name=".LabyrinthActivity"
			android:label="Лабиринт"
			android:screenOrientation="portrait"
			android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen"
			android:configChanges="orientation|screenSize" />

		<!-- 14. Офисный редактор документов -->
		<activity 
			android:name=".OfficeActivity"
			android:label="MS Office Редактор"
			android:configChanges="orientation|screenSize"
			android:theme="@android:style/Theme.Material" />
		<activity 
			android:name=".TimeActivity"
			android:label="Часы и Время"
			android:configChanges="orientation|screenSize" 
			android:theme="@android:style/Theme.Material" />
		<activity 
			android:name=".FileManagerActivity" 
			android:label="SMod Проводник"
			android:configChanges="orientation|screenSize" 
			android:theme="@android:style/Theme.Material" />
		<activity 
			android:name=".HorrorGameActivity"
			android:screenOrientation="portrait"
			android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" 
			android:configChanges="orientation|screenSize" />
		<activity 
			android:name=".KernelActivity" 
			android:label="Ядро"
			android:configChanges="orientation|screenSize" 
			android:theme="@android:style/Theme.Material" />

		<!-- 2. Автономный оффлайн-сервис Google / Vir ID для игр -->
		<activity 
			android:name=".GServisActivity" 
			android:label="Vir GServis Авторизация"
			android:configChanges="orientation|screenSize|keyboardHidden" 
			android:theme="@android:style/Theme.Material"/>

	</application>
	
</manifest>
