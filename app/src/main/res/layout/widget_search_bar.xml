<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:background="@drawable/widget_dark_bar_bg">

    <!-- Слева: Иконка приложения (icon1) -->
    <ImageView
        android:id="@+id/widget_icon1"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/icon1"
        android:contentDescription="App Icon" />

    <!-- Центр: Заполнитель/Текст-подсказка (занимает все свободное место) -->
    <TextView
        android:id="@+id/widget_search_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:text="Поиск или ввод URL..."
        android:textColor="#99FFFFFF"
        android:textSize="14sp" />

    
</LinearLayout>

